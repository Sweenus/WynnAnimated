{
  "schemaVersion": 1,
  "id": "wynnanimated",
  "version": "${version}",
  "name": "WynnAnimated",
  "description": "Character animations for Wynncraft",
  "authors": ["Sweenus"],
  "contact": {},
  "license": "Timefall Development License",
  "icon": "assets/wynnanimated/wa_icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "net.sweenus.wynnanimated.client.WynnanimatedDataGenerator"
    ],
    "client": [
      "net.sweenus.wynnanimated.client.WynnanimatedClient"
    ],
    "main": [
      "net.sweenus.wynnanimated.Wynnanimated"
    ],
    "modmenu": [
      "net.sweenus.wynnanimated.client.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "wynnanimated.mixins.json",
    {
      "config": "wynnanimated.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "fabric-api": "*",
    "minecraft": ">=1.21.11",
    "player_animation_library": "*",
    "wynntils": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
